  "unit_id": "denglou",
  "paragraphs": [
    {
      "id": 1,
      "label": "首聯",
      "text": "花近高樓傷客心，萬方多難此登臨。",
      "summary": "眼前繁花本應賞心悅目，卻反而使客居他鄉的詩人傷心，因為此刻正值天下多災多難，詩人在此時登臨此樓，感觸尤深。",
      "annotation_ids": [],
      "reader_annotation_ids": [
        "r1-001",
        "r1-002",
        "r1-003",
        "r1-004",
        "r1-005",
        "r1-006"
      ]
    },
    {
      "id": 2,
      "label": "頷聯",
      "text": "錦江春色來天地，玉壘浮雲變古今。",
      "summary": "錦江的春色鋪天蓋地而來，象徵江山亙古常新；玉壘山上的浮雲自古至今不斷變化，象徵時局動盪不定。",
      "annotation_ids": [
        "n01",
        "n02"
      ],
      "reader_annotation_ids": [
        "r2-007",
        "r2-008",
        "r2-009",
        "r2-010",
        "r2-011"
      ]
    },
    {
      "id": 3,
      "label": "頸聯",
      "text": "北極朝廷終不改，西山寇盜莫相侵。",
      "summary": "北方的朝廷如北極星般不會動搖，詩人告誡西邊的吐蕃寇盜不要再輕舉妄動，表達對國運的信心，亦隱含對時局的憂慮。",
      "annotation_ids": [
        "n03",
        "n04"
      ],
      "reader_annotation_ids": [
        "r3-012",
        "r3-013",
        "r3-014",
        "r3-015",
        "r3-016",
        "r3-017",
        "r3-018",
        "r3-019"
      ]
    },
    {
      "id": 4,
      "label": "尾聯",
      "text": "可憐後主還祠廟，日暮聊為梁甫吟。",
      "summary": "詩人感歎昏庸的後主劉禪竟仍有祠廟供後人祭祀，藉此諷諭唐代宗信任宦官、治國無方；日暮時分，詩人只能吟誦《梁甫吟》，抒發自己懷才不遇、報國無門的感慨。",
      "annotation_ids": [
        "n05",
        "n06"
      ],
      "reader_annotation_ids": [
        "r4-020",
        "r4-021",
        "r4-022",
        "r4-023",
        "r4-024",
        "r4-025",
        "r4-026",
        "r4-027"
      ]
    }
  ],
  "annotations": [
