  "annotations": [
    {
      "id": "n01",
      "term": "魚",
      "explanation": "魚營養豐富，是春秋戰國期間的美食。"
    },
    {
      "id": "n00b",
      "term": "兼",
      "explanation": "兼有、同時得到。"
    },
    {
      "id": "n02",
      "term": "熊掌",
      "explanation": "熊是山中野獸，難以捕獵，是珍貴的美食。"
    },
    {
      "id": "n03",
      "term": "舍魚而取熊掌",
      "explanation": "舍：通「捨」，放棄。"
    },
    {
      "id": "n04",
      "term": "生亦我所欲也",
      "explanation": "生：生命、性命。"
    },
    {
      "id": "n05",
      "term": "義亦我所欲也",
      "explanation": "義：正義、道義。此處指善性良知的實踐。"
    },
    {
      "id": "n06",
      "term": "甚於生者",
      "explanation": "甚於：在程度上超過。"
    },
    {
      "id": "n07",
      "term": "不為苟得也",
      "explanation": "苟得：指苟且偷生。苟：隨便、輕率。"
    },
    {
      "id": "n08",
      "term": "死亦我所惡",
      "jyutping": "wu3",
      "putonghua": "wù",
      "explanation": "惡：憎厭。"
    },
    {
      "id": "n09",
      "term": "故患有所不辟也",
      "explanation": "辟：通「避」。"
    },
    {
      "id": "n10",
      "term": "如使人之所欲",
      "explanation": "如：假如、假設。"
    },
    {
      "id": "n11",
      "term": "凡可以得生者",
      "explanation": "可以得生者：可以活下去的方法或機會。"
    },
    {
      "id": "n12",
      "term": "何不用也",
      "explanation": "用：選取、接受。"
    },
    {
      "id": "n13",
      "term": "由是則生而有不用也",
      "explanation": "承接上文的反問句，根據這些事例，可以活命的方法竟然有人不接受。"
    },
    {
      "id": "n14",
      "term": "是故所欲有甚於生者",
      "explanation": "是故：因此之故。"
    },
    {
      "id": "n15",
      "term": "所欲有甚於生者，所惡有甚於死者",
      "explanation": "人所追求的東西，有些比生命更重要；人所憎惡的東西，有些比死亡更嚴重。"
    },
    {
      "id": "n16",
      "term": "非獨賢者有是心也，人皆有之，賢者能勿喪耳",
      "explanation": "不僅賢人有這個「本心」，其實人人都有，唯獨賢人能夠堅持本心，不讓它喪失罷了。耳：這裏作為句末語助詞，是「而已」的合音字。"
    },
    {
      "id": "n17",
      "term": "簞",
      "jyutping": "daan1",
      "putonghua": "dɑ̄n",
      "explanation": "盛飯的竹器。食：飯食。"
    },
    {
      "id": "n18",
      "term": "一豆羹",
      "explanation": "豆：盛載食物的器皿，形似高腳盤，象形字。羹：指帶汁的肉食。"
    },
    {
      "id": "n19",
      "term": "弗得則死",
      "explanation": "弗：通「不」。"
    },
    {
      "id": "n20",
      "term": "嘑爾而與之",
      "explanation": "嘑爾：大聲呼叱的意思。一說「嘑」同「呼」。與：給予。"
    },
    {
      "id": "n21",
      "term": "行道之人弗受",
      "explanation": "行道之人：路人。弗受：不接受。"
    },
    {
      "id": "n22",
      "term": "蹴爾而與之",
      "explanation": "蹴：踐踏。爾：助詞，此處用於動詞之後，表示狀態，相當於「着」。"
    },
    {
      "id": "n23",
      "term": "乞人不屑也",
      "explanation": "不屑：輕視。"
    },
    {
      "id": "n24",
      "term": "萬鍾",
      "occurrence": 1,
      "explanation": "這裏解作達官貴人豐厚的俸祿。鍾：古代的一種量器，此處作量詞用，表示俸祿的數量。"
    },
    {
      "id": "n25",
      "term": "不辯禮義而受之",
      "explanation": "辯：通「辨」，辨別。"
    },
    {
      "id": "n26",
      "term": "萬鍾於我何加焉",
      "explanation": "何加：有甚麼好處？加：增益。"
    },
    {
      "id": "n27",
      "term": "宮室之美",
      "occurrence": 1,
      "explanation": "宮室：居所。並非後世「皇宮」之意。"
    },
    {
      "id": "n28",
      "term": "妻妾之奉",
      "occurrence": 1,
      "explanation": "奉：供奉、服侍。"
    },
    {
      "id": "n29",
      "term": "所識窮乏者得我與",
      "occurrence": 1,
      "explanation": "讓所認識的窮乏之人感謝我的賙濟嗎？得：通「德」，感激，作動詞用。與：通「歟」，表示反問的語氣詞。"
    },
    {
      "id": "n30",
      "term": "鄉為身死而不受",
      "occurrence": 1,
      "explanation": "鄉：通「向」，過往。"
    },
    {
      "id": "n31",
      "term": "是亦不可以已乎",
      "explanation": "已：停止。"
    },
    {
      "id": "n32",
      "term": "此之謂失其本心",
      "explanation": "本心：指人人本來都有的良心、本性，如羞惡之心、重義之心。"
    }
  ],
