{
  "unit_id": "niannujiao-chibihuaigu",
  "paragraphs": [
    {
      "id": 1,
      "label": "上片‧起筆",
      "text": "大江東去，浪淘盡、千古風流人物。",
      "summary": "以滾滾東流的大江起筆，展現雄闊的意境空間，藉江水東去強調時間流逝，帶出千古風流人物如被江浪淘盡，物是人非之感。",
      "annotation_ids": [],
      "reader_annotation_ids": [
        "r1-001",
        "r1-002",
        "r1-003",
        "r1-004",
        "r1-005"
      ]
    },
    {
      "id": 2,
      "label": "上片‧點題",
      "text": "故壘西邊，人道是、三國周郎赤壁。",
      "summary": "直扣詞題「赤壁懷古」，說眼前赤壁磯相傳是三國赤壁大戰的戰場，「人道是」表明只是傳言，藉此引發懷古之情。",
      "annotation_ids": [
        "n01",
        "n02"
      ],
      "reader_annotation_ids": [
        "r2-006",
        "r2-007",
        "r2-008",
        "r2-009"
      ]
    },
    {
      "id": 3,
      "label": "上片‧寫景",
      "text": "亂石穿空，驚濤拍岸，捲起千堆雪。江山如畫，一時多少豪傑！",
      "summary": "具體描寫赤壁磯崖岸險峻、驚濤拍岸、浪花如雪的壯觀景色，總結大好江山曾出現無數令人景仰的豪傑。",
      "annotation_ids": [],
      "reader_annotation_ids": [
        "r3-010",
        "r3-011",
        "r3-012",
        "r3-013",
        "r3-014",
        "r3-015",
        "r3-016",
        "r3-017"
      ]
    },
    {
      "id": 4,
      "label": "下片‧懷人",
      "text": "遙想公瑾當年，小喬初嫁了，雄姿英發。羽扇綸巾，談笑間、檣櫓灰飛煙滅。",
      "summary": "由眼前赤壁磯跨越時空，想到周瑜當年娶得小喬、雄姿英發，並手搖羽扇、談笑間大破曹軍的儒將風采。",
      "annotation_ids": [
        "n03",
        "n04",
        "n05"
      ],
      "reader_annotation_ids": [
        "r4-018",
        "r4-019",
        "r4-020",
        "r4-021",
        "r4-022",
        "r4-023",
        "r4-024",
        "r4-025",
        "r4-026"
      ]
    },
    {
      "id": 5,
      "label": "下片‧自傷",
      "text": "故國神遊，多情應笑我，早生華髮。",
      "summary": "詞人感慨自己神遊故地，年華逝去而功業無成，借懷念周瑜等三國人物建功立業，反襯自己被貶黃州、懷才不遇的苦悶。",
      "annotation_ids": [
        "n06",
        "n07"
      ],
      "reader_annotation_ids": [
        "r5-027",
        "r5-028",
        "r5-029",
        "r5-030",
        "r5-031"
      ]
    },
    {
      "id": 6,
      "label": "下片‧收結",
      "text": "人間如夢，一尊還酹江月。",
      "summary": "由懷古歷史回到現實，感悟世事如夢，個人仕途得失亦如夢一場，不如舉杯灑酒祭奠江月，遣懷消愁，展現曠達心境。",
      "annotation_ids": [
        "n08",
        "n09"
      ],
      "reader_annotation_ids": [
        "r6-032",
        "r6-033",
        "r6-034",
        "r6-035",
        "r6-036",
        "r6-037"
      ]
    }
  ],
