    {
      "id": "n39",
      "term": "君子成人之美，不成人之惡",
      "explanation": "君子成全別人的好事，不促成別人的壞事。"
    },
    {
      "id": "n40",
      "term": "小人反是",
      "explanation": "小人卻和這個相反。"
    },
    {
      "id": "n41",
      "term": "君子恥其言而過其行",
      "explanation": "君子會因為自己說得多，但做得少而感到羞恥。行：行為、行事。"
    },
    {
      "id": "n42",
      "term": "君子義以為質",
      "explanation": "君子處事，以合宜為原則。質：本質。義以為質，即以義為本。"
    },
    {
      "id": "n43",
      "term": "禮以行之，孫以出之，信以成之",
      "explanation": "依禮節實行它，用謙遜的言語說出它，用誠實的態度完成它。孫：通「遜」，謙遜。"
    },
    {
      "id": "n44",
      "term": "君子病無能焉，不病人之不己知也",
      "explanation": "君子只會因自己沒有能力而慚愧，卻不會抱怨別人不了解自己。病：憂慮，擔心；也可解作慚愧、抱怨。"
    },
    {
      "id": "n45",
      "term": "君子求諸己，小人求諸人",
      "explanation": "君子要求自己，小人則只會要求別人。諸：即「之於」，介詞。"
    },
