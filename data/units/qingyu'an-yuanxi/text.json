  "unit_id": "qingyu'an-yuanxi",
  "paragraphs": [
    {
      "id": 1,
      "label": "上片‧花燈煙火",
      "text": "東風夜放花千樹，更吹落、星如雨。",
      "summary": "春風吹起的夜晚，花燈像千棵樹上綻放的花兒，煙花如被吹落的星雨，以比喻和想像為上片的元宵夜景定下繁盛華麗的基調。",
      "annotation_ids": [],
      "reader_annotation_ids": [
        "r1-001",
        "r1-002",
        "r1-003",
        "r1-004",
        "r1-005",
        "r1-006"
      ]
    },
    {
      "id": 2,
      "label": "上片‧寶馬笙歌",
      "text": "寶馬雕車香滿路。鳳簫聲動，玉壺光轉，一夜魚龍舞。",
      "summary": "名貴的馬車在路上來回走動，車上傳來陣陣衣鬢香氣；簫聲四處繚繞，月光流轉，魚龍形狀的彩燈徹夜飛舞，多感官描寫元宵盛況。",
      "annotation_ids": [
        "n01",
        "n02",
        "n03",
        "n04"
      ],
      "reader_annotation_ids": [
        "r2-007",
        "r2-008",
        "r2-009",
        "r2-010",
        "r2-011",
        "r2-012",
        "r2-013",
        "qingyuan-yuanxi-teacher-2-1",
        "qingyuan-yuanxi-teacher-2-2"
      ]
    },
    {
      "id": 3,
      "label": "下片‧仕女盛裝",
      "text": "蛾兒雪柳黃金縷，笑語盈盈暗香去。",
      "summary": "穿戴漂亮頭飾的女子，儀態萬千，笑着說着走過，衣鬢香氣隨其步伐遠去，承接上片視覺描寫並轉入聽覺、嗅覺描寫。",
      "annotation_ids": [
        "n05",
        "n06"
      ],
      "reader_annotation_ids": [
        "r3-014",
        "r3-015",
        "r3-016",
        "r3-017",
        "r3-018",
        "r3-019",
        "qingyuan-yuanxi-teacher-3-3"
      ]
    },
    {
      "id": 4,
      "label": "下片‧尋人不見",
      "text": "眾裏尋他千百度。",
      "summary": "作者在人群中尋找「那人」千百次而不見，經過重重轉折，帶引讀者體會尋覓過程的焦急與執着。",
      "annotation_ids": [
        "n07"
      ],
      "reader_annotation_ids": [
        "r4-020",
        "r4-021",
        "r4-022",
        "r4-023",
        "qingyuan-yuanxi-teacher-4-4"
      ]
    },
    {
      "id": 5,
      "label": "下片‧驀然驚喜",
      "text": "驀然迴首，那人卻在，燈火闌珊處。",
      "summary": "忽然回頭一看，才發現要找的「那人」原來就在燈火暗淡零落之處，全詞的主角在動態繁華中以靜態孤高的形象呈現，全詞焦點聚於此。",
      "annotation_ids": [
        "n08",
        "n09"
      ],
      "reader_annotation_ids": [
        "r5-024",
        "r5-025",
        "r5-026",
        "r5-027",
        "r5-028"
      ]
    }
  ],
  "annotations": [
    {
      "id": "n01",
      "term": "寶馬雕車",
      "explanation": "寶馬：名貴的駿馬。雕車：飾有雕花、彩繪的車；裝飾華麗的車。香：指車中人的衣鬢之香。"
    },
    {
      "id": "n02",
      "term": "鳳簫聲動",
      "explanation": "樂聲四處繚繞。鳳簫：即排簫，比竹為之，參差如鳳翼，故名。一說是簫的美稱。"
    },
    {
      "id": "n03",
      "term": "玉壺光轉",
      "jyutping": "zyun3",
      "putonghua": "zhuɑ̌n",
      "explanation": "玉壺：喻明月。一說指白玉造的燈，一說指漏壺，即古代計時器。光轉：月光照射的位置轉變，意指時間推移。"
    },
    {
      "id": "n04",
      "term": "魚龍舞",
      "explanation": "指舞動魚形、龍形的彩燈。"
    },
    {
      "id": "n05",
      "term": "蛾兒雪柳黃金縷",
      "jyutping": "leoi5",
      "putonghua": "lǚ",
      "explanation": "描寫路上的女子穿戴着各種頭飾。蛾兒：古代婦女於元宵節前後插戴在頭上，用烏金紙剪裁成蝶或蛾狀的飾物。雪柳：宋代婦女在立春日和元宵節時插戴的一種絹或紙製成的頭花。黃金縷：古代婦女戴在頭上的金色頭飾。縷：泛指線狀物。"
    },
    {
      "id": "n06",
      "term": "盈盈",
      "explanation": "儀態美好，微笑含情的樣子。"
    },
    {
      "id": "n07",
      "term": "度",
      "explanation": "次、回。"
    },
    {
      "id": "n08",
      "term": "驀然",
      "explanation": "突然、忽然。迴：一作「回」。"
    },
    {
      "id": "n09",
      "term": "闌珊",
      "explanation": "暗淡、零落。"
    }
  ],
