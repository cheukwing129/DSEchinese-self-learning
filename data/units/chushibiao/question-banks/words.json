  "questions": [
    {
      "id": "cb-words-001",
      "unit": "chushibiao",
      "ability": "字詞",
      "knowledge_point": "虛詞辨析：以",
      "question_type": "single_choice",
      "is_cross_text": true,
      "paragraph_ref": 6,
      "difficulty": "advanced",
      "stem": "以下哪一句中的「以」字與「先帝不以臣卑鄙，猥自枉屈」（第6段）一句中的「以」字具相同詞義？",
      "score": 1,
      "options": [
        {
          "key": "A",
          "text": "是以先帝簡拔以遺陛下。（《出師表》）"
        },
        {
          "key": "B",
          "text": "以是人多以書假余，余因得遍觀羣書。（宋濂《送東陽馬生序》）"
        },
        {
          "key": "C",
          "text": "不以物喜，不以己悲。（《岳陽樓記》）"
        },
        {
          "key": "D",
          "text": "忠之屬也，可以一戰。（《左傳．曹劌論戰》）"
        }
      ],
      "answer": "C",
      "explanation": "「不以臣卑鄙」的「以」是介詞，解「因為」；C項「不以物喜」的「以」同樣解「因為」。A項「以」解「來」；B項「以」解「因為」但語境不同（此為另一常見用法，供辨析參考）；D項「以」解「用來」。",
      "source": "校本試題庫"
    },
    {
      "id": "cb-words-002",
      "unit": "chushibiao",
      "ability": "字詞",
      "knowledge_point": "虛詞辨析：於",
      "question_type": "single_choice",
      "is_cross_text": true,
      "paragraph_ref": 1,
      "difficulty": "advanced",
      "stem": "以下哪一句中的「於」字與「今天下三分，益州疲弊，此誠危急存亡之秋也」（第1段）「忘身於外者」一句中的「於」字具相同詞義？",
      "score": 1,
      "options": [
        {
          "key": "A",
          "text": "苟全性命於亂世，不求聞達於諸侯。（《出師表》）"
        },
        {
          "key": "B",
          "text": "每與臣論此事，未嘗不歎息痛恨於桓、靈也。（《出師表》）"
        },
        {
          "key": "C",
          "text": "青，取之於藍，而青於藍。（《荀子．勸學》）"
        },
        {
          "key": "D",
          "text": "冰，水為之，而寒於水。（《荀子．勸學》）"
        }
      ],
      "answer": "A",
      "explanation": "「忘身於外」的「於」是介詞，解「在」；A項「性命於亂世」「聞達於諸侯」的「於」同樣解「在」。B項「於」表對象；C、D項「於」表比較，解「比」。",
      "source": "校本試題庫"
    },
