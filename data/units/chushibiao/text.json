  "annotations": [
    {
      "id": "n01",
      "term": "中道崩殂",
      "jyutping": "cou4",
      "putonghua": "cú",
      "explanation": "中途駕崩了。崩殂：指皇帝之死。殂：死亡。劉備稱帝三年即死去，沒有完成統一天下的大業。"
    },
    {
      "id": "n02",
      "term": "今天下三分",
      "explanation": "如今天下已形成魏、蜀、吳三國鼎立的局面。"
    },
    {
      "id": "n03",
      "term": "益州疲弊",
      "explanation": "益州：指蜀漢所在地（今四川省一帶）。疲弊：指國力困乏。"
    },
    {
      "id": "n04",
      "term": "不懈於內",
      "explanation": "懈：懈怠。內：指朝廷內。忠志：忠誠。士：將士。忘身：指奮不顧身，不怕犧牲。"
    },
    {
      "id": "n05",
      "term": "蓋追先帝之殊遇",
      "explanation": "蓋：連詞，承接上文，說明原因，相當於因為、由於。殊遇：特別優厚的待遇。"
    },
    {
      "id": "n06",
      "term": "開張聖聽",
      "explanation": "廣泛地聽取群臣的意見。開張：開展之意。聖聽：聖明之聽，對皇帝聽取意見的尊稱。"
    },
    {
      "id": "n07",
      "term": "以光先帝遺德",
      "explanation": "光：發揚光大，作動詞用。"
    },
    {
      "id": "n08",
      "term": "恢弘志士之氣",
      "explanation": "振奮、激勵志士的精神氣節。恢弘：發揚、擴大，作動詞用。"
    },
    {
      "id": "n09",
      "term": "不宜妄自菲薄",
      "jyutping": "fei2",
      "putonghua": "fěi",
      "explanation": "妄：胡亂地。菲薄：輕視。"
    },
    {
      "id": "n10",
      "term": "引喻失義",
      "explanation": "隨便引用不合道理的話。義：社會認為合宜的道理和行為。"
    },
    {
      "id": "n11",
      "term": "宮中、府中",
      "explanation": "宮中：指皇帝宮裏的侍臣。府中：指丞相府所屬的官吏，即一般官吏。"
    },
    {
      "id": "n12",
      "term": "陟罰臧否",
      "jyutping": "zik1 / zong1 / pei2",
      "putonghua": "zhì / zɑ̄nɡ / pǐ",
      "explanation": "即「陟臧罰否」，賞善罰惡。陟：升。罰：懲罰。臧：善，或引申為褒賞。否：惡，或引申為貶斥。"
    },
    {
      "id": "n13",
      "term": "作姦犯科",
      "explanation": "為非作惡、干犯法紀。姦：邪惡、不正當。科：法律條文。為忠善者：盡忠為善的人。"
    },
    {
      "id": "n14",
      "term": "宜付有司",
      "explanation": "有司：官吏的通稱。"
    },
    {
      "id": "n15",
      "term": "以昭陛下平明之治",
      "explanation": "昭：彰顯。平明：公正嚴明。治：治理。「平明之治」一作「平明之理」。"
    },
    {
      "id": "n16",
      "term": "使內外異法也",
      "explanation": "宮中、宮外執法有別。異法：不同的準則。"
    },
    {
      "id": "n17",
      "term": "侍中、侍郎郭攸之、費禕、董允等",
      "jyutping": "ji1",
      "putonghua": "yī",
      "explanation": "當時郭攸之任侍中，費禕曾任黃門侍郎，後升為侍中，董允任黃門侍郎。"
    },
    {
      "id": "n18",
      "term": "此皆良實，志慮忠純",
      "explanation": "良實：善良忠實。志慮：志向和心思。"
    },
    {
      "id": "n19",
      "term": "是以先帝簡拔以遺陛下",
      "jyutping": "wai6",
      "putonghua": "wèi",
      "explanation": "遺：給予。"
    },
    {
      "id": "n20",
      "term": "悉以咨之",
      "explanation": "悉：全部。咨：通「諮」，詢問。之：代詞，代上文所述各人。"
    },
    {
      "id": "n21",
      "term": "必能裨補闕漏",
      "jyutping": "bei1 / kyut3",
      "putonghua": "bì / quē",
      "explanation": "裨：彌補、補益。闕漏：缺憾和遺漏之處。"
    },
    {
      "id": "n22",
      "term": "將軍向寵，性行淑均",
      "explanation": "向寵：當時任中部督，掌宿衛兵，負責保護皇帝。劉備伐吳兵敗，只有他的軍營完好無損。諸葛亮北伐時，留他掌管軍事。性行淑均：性格和善，為人公正。行：品行。"
    },
    {
      "id": "n23",
      "term": "必能使行陣和睦，優劣得所",
      "jyutping": "hong4",
      "putonghua": "hɑ́nɡ",
      "explanation": "一定能使軍隊和睦，讓才能高低不同的將士都會被安排擔當適當的職位。行陣：行列，這裏指軍中將士。"
    },
    {
      "id": "n24",
      "term": "遠小人",
      "jyutping": "jyun6",
      "putonghua": "yuɑ̀n",
      "explanation": "遠：疏遠，作動詞用。"
    },
    {
      "id": "n25",
      "term": "未嘗不歎息痛恨於桓、靈也",
      "explanation": "桓、靈：東漢末年桓帝和靈帝。他們用人不當，寵信宦官，政治腐敗，造成漢末大亂。諸葛亮特意提及桓、靈二帝，是希望後主有所警惕。"
    },
    {
      "id": "n26",
      "term": "侍中、尚書、長史、參軍",
      "explanation": "侍中：指前文提及的郭攸之和費禕。尚書：指陳震。長史：指張裔。參軍：指蔣琬。"
    },
    {
      "id": "n27",
      "term": "臣本布衣，躬耕於南陽",
      "explanation": "諸葛亮早年隱居於南陽鄧縣（今湖北省襄陽市）的隆中，後劉備三次前往他家中拜訪，他才出山輔佐劉備。布衣：古代庶民之服，借代平民。"
    },
    {
      "id": "n28",
      "term": "不求聞達於諸侯",
      "explanation": "聞：聞名、名聲。達：顯達。"
    },
    {
      "id": "n29",
      "term": "先帝不以臣卑鄙，猥自枉屈",
      "jyutping": "wai2",
      "putonghua": "wěi",
      "explanation": "卑鄙：指地位低微，見識鄙陋。猥：謙辭，降低身份之意。枉屈：即委屈之意。顧：看望、拜訪。"
    },
    {
      "id": "n30",
      "term": "遂許先帝以驅馳",
      "explanation": "驅馳：奔走效勞。"
    },
    {
      "id": "n31",
      "term": "後值傾覆",
      "explanation": "傾覆：兵敗。公元208年，劉備在當陽（今湖北省當陽東北）附近被曹操打敗。「受任」一作「受命」。"
    },
    {
      "id": "n32",
      "term": "爾來二十有一年矣",
      "explanation": "爾來：從那時以來。有：通「又」。"
    },
    {
      "id": "n33",
      "term": "夙夜憂歎",
      "jyutping": "suk1",
      "putonghua": "sù",
      "explanation": "夙：早上。"
    },
    {
      "id": "n34",
      "term": "故五月渡瀘，深入不毛",
      "explanation": "所以五月渡過瀘水，深入不毛之地。瀘：瀘水，指今四川雅礱江下游和金沙江匯合雅礱江後一段。因為有瘴氣，三四月渡河有生命危險。建興三年，諸葛亮曾率軍南征，平定了南方諸郡的叛亂。不毛：不生長草木，指土地貧瘠或未經開發之地。"
    },
    {
      "id": "n35",
      "term": "庶竭駑鈍，攘除姦凶",
      "jyutping": "nou4 / joeng4",
      "putonghua": "nú / rɑ̌nɡ",
      "explanation": "竭盡我平庸的才能，剷除姦險凶惡的勢力（指曹魏政權）。庶：表示意願的副詞。駑鈍：能力低下，愚鈍。駑：劣馬。"
    },
    {
      "id": "n36",
      "term": "還於舊都",
      "explanation": "舊都：指兩漢的都城長安和洛陽。"
    },
    {
      "id": "n37",
      "term": "至於斟酌損益",
      "explanation": "斟酌：反復衡量，考慮取捨。損益：減少和增加，也可解作利弊。"
    },
    {
      "id": "n38",
      "term": "以彰其咎",
      "explanation": "興：發揚，動詞。慢：怠慢。彰：彰顯。咎：過失。"
    },
    {
      "id": "n39",
      "term": "以諮諏善道，察納雅言",
