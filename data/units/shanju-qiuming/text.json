{
  "unit_id": "shanju-qiuming",
  "paragraphs": [
    {
      "id": 1,
      "label": "首聯",
      "text": "空山新雨後，天氣晚來秋。",
      "summary": "點出季節、時間、環境：空山剛下過一場雨，又正是傍晚秋涼的天氣，描繪出山中秋色的清新疏淡。",
      "annotation_ids": [
        "n01"
      ],
      "reader_annotation_ids": [
        "r1-001",
        "r1-002",
        "r1-003",
        "r1-004"
      ]
    },
    {
      "id": 2,
      "label": "頷聯",
      "text": "明月松間照，清泉石上流。",
      "summary": "以概括的筆墨描繪山中夜色：松林間露出一輪皎潔明月，泉水流過山溪白石，畫面鮮明完整，突出清朗爽淨的基調。",
      "annotation_ids": [],
      "reader_annotation_ids": [
        "r2-005",
        "r2-006",
        "r2-007"
      ]
    },
    {
      "id": 3,
      "label": "頸聯",
      "text": "竹喧歸浣女，蓮動下漁舟。",
      "summary": "轉作動態描寫：竹林傳來洗衣女的談笑聲，蓮花蓮葉搖動因漁舟歸來，以動景映襯前兩聯的靜景，顯現自然多樣的動態美。",
      "annotation_ids": [
        "n02",
        "n03"
      ],
      "reader_annotation_ids": [
        "r3-008",
        "r3-009",
        "r3-010",
        "r3-011",
        "r3-012",
        "r3-013"
      ]
    },
    {
      "id": 4,
      "label": "尾聯",
      "text": "隨意春芳歇，王孫自可留。",
      "summary": "任憑春天芳草自然凋謝，秋色仍然很美，王孫自可留在山中，反用《楚辭‧招隱士》之意，流露對隱居生活的嚮往。",
      "annotation_ids": [
        "n04"
      ],
      "reader_annotation_ids": [
        "r4-014",
        "r4-015",
        "r4-016",
        "r4-017",
        "r4-018",
        "r4-019",
        "r4-020"
      ]
    }
  ],
