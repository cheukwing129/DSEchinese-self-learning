  "annotations": [
    {
      "id": "n01",
      "term": "僇人",
      "jyutping": "luk6",
      "putonghua": "lù",
      "explanation": "獲罪受刑戮的人，泛指罪人。柳宗元因參與王叔文的永貞革新，革新失敗後受牽連而被貶為永州司馬，故以此自稱。僇：同「戮」，刑戮。"
    },
    {
      "id": "n02",
      "term": "恒惴慄",
      "jyutping": "zeoi3 leot6",
      "putonghua": "zhuì lì",
      "explanation": "恒：恆常、經常。惴：恐懼。慄：戰慄。"
    },
    {
      "id": "n03",
      "term": "隙",
      "explanation": "空隙，指閒暇的時間。"
    },
    {
      "id": "n04",
      "term": "施施",
      "jyutping": "si1 / ji4",
      "putonghua": "shī / yí",
      "explanation": "徐徐地行走的樣子；或解作喜悅自得的樣子。"
    },
    {
      "id": "n05",
      "term": "漫漫",
      "explanation": "隨意、無拘無束的樣子。"
    },
    {
      "id": "n06",
      "term": "徒",
      "explanation": "意氣相投的朋友。張衡《思玄賦》：「朋精粹而為徒。」"
    },
    {
      "id": "n07",
      "term": "窮迴溪",
      "explanation": "走到曲折溪流的盡處。窮：窮盡，指走到溪水盡頭處，動詞。迴：迂迴曲折。"
    },
    {
      "id": "n08",
      "term": "幽泉",
      "explanation": "清幽、僻靜的泉水。"
    },
    {
      "id": "n09",
      "term": "披草",
      "explanation": "撥開草叢。披：用手撥開。"
    },
    {
      "id": "n10",
      "term": "更相枕",
      "explanation": "互相枕着對方的身體。更相：互相。枕：以頭枕物。"
    },
    {
      "id": "n11",
      "term": "意有所極",
      "explanation": "彼此意趣淋漓之際。極：至、到。"
    },
    {
      "id": "n12",
      "term": "夢亦同趣",
      "explanation": "連夢境也意趣相投。趣：情趣、意境；或通「趨」，前往、朝着某方向。"
    },
    {
      "id": "n13",
      "term": "覺",
      "explanation": "醒過來。"
    },
    {
      "id": "n14",
      "term": "西山",
      "explanation": "位於永州城西。"
    },
    {
      "id": "n15",
      "term": "法華西亭",
      "explanation": "位於永州法華寺西面，為柳宗元所建。《永州法華寺新作西亭記》：「余時謫為州司馬，官外乎常員，而心得無事。乃取官之祿秩，以為其亭，其高且廣，蓋方丈者二焉。」"
    },
    {
      "id": "n16",
      "term": "異之",
      "explanation": "發現它（西山）與別不同之處，感到詫異。異：作動詞用，感到詫異、驚訝，在此句中解作褒義的驚喜。"
    },
    {
      "id": "n17",
      "term": "湘江",
      "explanation": "又名湘水。此處其實是瀟水，為湘江的支流。"
    },
    {
      "id": "n18",
      "term": "緣",
      "explanation": "沿着、順着。染溪：又名冉溪，柳宗元更名曰愚溪。"
    },
    {
      "id": "n19",
      "term": "斫榛莽",
      "jyutping": "zoek3",
      "putonghua": "zhuó",
      "explanation": "斫：砍伐。榛莽：雜亂叢生的草木。"
    },
    {
      "id": "n20",
      "term": "茅茷",
      "explanation": "茂密的茅草。茷：草葉茂盛的樣子。"
    },
    {
      "id": "n21",
      "term": "箕踞而遨",
      "jyutping": "gei1 geoi3",
      "putonghua": "jī jù",
      "explanation": "隨意而坐，游目四盼。箕踞：張開雙腿而坐，形如筲箕，指輕鬆隨意、不拘禮節的坐姿。遨：隨意遊玩，在此句中解作游目四顧。"
    },
    {
      "id": "n22",
      "term": "土壤",
      "explanation": "土地。"
    },
    {
      "id": "n23",
