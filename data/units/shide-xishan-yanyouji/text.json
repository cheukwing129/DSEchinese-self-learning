      "term": "莫得其涯",
      "explanation": "不知道或看不見它的盡頭在哪裏。涯：邊際、極限。"
    },
    {
      "id": "n34",
      "term": "洋洋",
      "explanation": "廣大無涯的樣子。"
    },
    {
      "id": "n35",
      "term": "與造物者遊",
      "explanation": "與造物者一起遨遊天地之間，意謂與天地合而為一。《莊子‧大宗師》：「彼方且與造物者為人，而遊乎天地之一氣。」"
    },
    {
      "id": "n36",
      "term": "窮",
      "explanation": "盡頭處。"
    },
    {
      "id": "n37",
      "term": "引觴滿酌",
      "jyutping": "soeng1",
      "putonghua": "shāng",
      "explanation": "引：取、拿起。觴：酒器。酌：斟酒。"
    },
    {
      "id": "n38",
      "term": "頹然",
      "explanation": "萎靡。這裏形容作者站不穩、醉醺醺的樣子。"
    },
    {
      "id": "n39",
      "term": "蒼然暮色",
      "explanation": "暮色深沉。蒼：青色、深綠色。色：景色、天色。"
    },
    {
      "id": "n40",
      "term": "心凝形釋",
      "explanation": "心神凝聚，形體不受拘束。凝：凝聚。釋：釋放，把塵世的禮俗規範豁出去。"
    },
    {
      "id": "n41",
      "term": "萬化冥合",
      "jyutping": "ming4",
      "putonghua": "mínɡ",
      "explanation": "萬化：萬物，這裏指大自然。冥合：相互契合。"
    },
    {
      "id": "n42",
      "term": "嚮",
      "explanation": "通「向」，從前、過往。"
    },
    {
      "id": "n43",
      "term": "未始",
      "explanation": "未嘗、不曾。"
    },
    {
      "id": "n44",
      "term": "志",
      "explanation": "通「誌」，記述其事。"
    }
