  "questions": [
    {
      "id": "cb-words-001",
      "unit": "shide-xishan-yanyouji",
      "ability": "字詞",
      "knowledge_point": "解釋粗體字",
      "question_type": "short_answer",
      "is_cross_text": false,
      "paragraph_ref": 1,
      "difficulty": "basic",
      "stem": "根據柳宗元《始得西山宴遊記》一文，解釋以下文句中粗體字的意思。",
      "score": 5,
      "items": [
        {
          "text": "日與其徒上高山，入深林。",
          "target": "徒",
          "answer": "朋友"
        },
        {
          "text": "到則披草而坐，傾壺而醉。",
          "target": "披",
          "answer": "用手撥開"
        },
        {
          "text": "覺而起，起而歸。",
          "target": "覺",
          "answer": "睡醒"
        },
        {
          "text": "然後知吾嚮之未始遊。",
          "target": "嚮",
          "answer": "從前、過往（通「向」）"
        },
        {
          "text": "遊於是乎始，故為之文以志。",
          "target": "志",
          "answer": "記述其事（通「誌」）"
        }
      ],
      "source": "校本試題庫"
    },
    {
      "id": "cb-words-002",
      "unit": "shide-xishan-yanyouji",
      "ability": "字詞",
      "knowledge_point": "詞性與詞義",
      "question_type": "short_answer",
      "is_cross_text": false,
      "paragraph_ref": 1,
      "difficulty": "intermediate",
      "stem": "根據柳宗元《始得西山宴遊記》一文，試指出以下句子中粗體字的詞性及詞義。",
      "score": 5,
      "items": [
        {
          "text": "日與其徒上高山，入深林。",
          "target": "日",
          "answer": "名詞作副詞，解「每天」"
        },
        {
          "text": "其隙也，則施施而行，漫漫而遊。",
          "target": "隙",
          "answer": "名詞，解「空隙，指閒暇的時間」"
        },
        {
          "text": "醉則更相枕以卧，卧而夢。",
          "target": "枕",
          "answer": "動詞，解「以頭枕物」"
        },
        {
          "text": "窮山之高而止。",
          "target": "窮",
          "answer": "動詞，解「走到盡頭」"
        },
        {
          "text": "縈青繚白，外與天際，四望如一。",
          "target": "際",
          "answer": "動詞，解「相連、匯合」"
        }
      ],
      "source": "校本試題庫"
    },
    {
      "id": "cb-words-003",
      "unit": "shide-xishan-yanyouji",
      "ability": "字詞",
      "knowledge_point": "「始」字多義辨析",
      "question_type": "short_answer",
      "is_cross_text": false,
      "paragraph_ref": null,
      "difficulty": "advanced",
      "stem": "《始得西山宴遊記》中，「始」一字多次出現，意義不盡相同。試指出以下句子中「始」字的意義（可選：開始／算不上／曾經／根本／才）。",
      "score": 3,
      "items": [
        {
          "text": "而未始知西山之怪特",
          "target": "始",
          "answer": "曾經"
        },
        {
          "text": "始指異之",
          "target": "始",
          "answer": "才"
        },
        {
          "text": "遊於是乎始",
          "target": "始",
          "answer": "開始"
        }
      ],
      "source": "校本試題庫"
    },
    {
      "id": "cb-words-004",
      "unit": "shide-xishan-yanyouji",
      "ability": "字詞",
      "knowledge_point": "虛詞辨析：之",
      "question_type": "single_choice",
      "is_cross_text": true,
      "paragraph_ref": 1,
      "difficulty": "advanced",
      "stem": "「之」是常見的文言虛詞，以下哪一句中的「之」字，與「而未始知西山之怪特」（《始得西山宴遊記》）一句中「之」字的用法不同？",
      "score": 2,
      "options": [
        {
          "key": "A",
          "text": "雖有槁暴，不復挺者，輮使之然也。（《荀子‧勸學》（節錄））"
        },
        {
          "key": "B",
          "text": "則夫子猶有蓬之心也夫！（《逍遙遊》節錄）"
        },
        {
          "key": "C",
          "text": "欲勿與，即患秦兵之來。（《史記‧廉頗藺相如列傳》（節錄））"
        },
        {
          "key": "D",
          "text": "此誠危急存亡之秋也。（《出師表》）"
        }
      ],
      "answer": "A",
      "explanation": "「西山之怪特」的「之」是結構助詞，用於定語與中心語之間，相當於「的」；B、D項「之」同樣是結構助詞「的」；C項「秦兵之來」的「之」用於主謂之間，取消句子獨立性；A項「使之然也」的「之」是代詞，代指「木」，用法不同。",
      "source": "校本試題庫"
    },
