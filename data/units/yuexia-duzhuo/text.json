{
  "unit_id": "yuexia-duzhuo",
  "paragraphs": [
    {
      "id": 1,
      "label": "第一段",
      "text": "花間一壺酒，獨酌無相親。",
      "summary": "點出李白獨酌，無人相伴的處境。",
      "annotation_ids": [
        "n01"
      ],
      "reader_annotation_ids": [
        "r1-001",
        "r1-002",
        "r1-003",
        "r1-004",
        "r1-005"
      ]
    },
    {
      "id": 2,
      "label": "第二段",
      "text": "舉杯邀明月，對影成三人。",
      "summary": "寫李白忽發奇想，舉杯邀請月亮和身影共飲，以消解孤獨苦悶之情。",
      "annotation_ids": [
        "n02"
      ],
      "reader_annotation_ids": [
        "r2-006",
        "r2-007",
        "r2-008",
        "r2-009"
      ]
    },
    {
      "id": 3,
      "label": "第三段",
      "text": "月既不解飲，影徒隨我身。",
      "summary": "雖有月和影相伴，但月畢竟不會飲酒，影子也徒然跟隨身體而動，情感又復歸孤獨。",
      "annotation_ids": [
        "n03"
      ],
      "reader_annotation_ids": [
        "r3-010",
        "r3-011",
        "r3-012",
        "r3-013",
        "r3-014",
        "r3-015"
      ]
    },
    {
      "id": 4,
      "label": "第四段",
      "text": "暫伴月將影，行樂須及春。",
      "summary": "月、影雖不解飲，但暫時與之一同行樂，以不負春日良辰。",
      "annotation_ids": [
        "n04",
        "n05"
      ],
      "reader_annotation_ids": [
        "r4-016",
        "r4-017",
        "r4-018",
        "r4-019",
        "r4-020",
        "r4-021"
      ]
    },
    {
      "id": 5,
      "label": "第五段",
      "text": "我歌月徘徊，我舞影零亂。",
      "summary": "寫李白高歌，月亮好像徘徊起舞；舞動時因酒醉而令身影變得散亂，意思愈轉愈奇。",
      "annotation_ids": [
        "n06"
      ],
      "reader_annotation_ids": [
        "r5-022",
        "r5-023",
        "r5-024"
      ]
    },
    {
      "id": 6,
      "label": "第六段",
      "text": "醒時同交歡，醉後各分散。",
      "summary": "未醉時與月、影共樂，已醉後則復歸與月和影分離，流露出依然孤獨之傷歎。",
      "annotation_ids": [
        "n07"
      ],
      "reader_annotation_ids": [
        "r6-025",
        "r6-026",
        "r6-027"
      ]
    },
    {
      "id": 7,
      "label": "第七段",
      "text": "永結無情遊，相期邈雲漢。",
      "summary": "筆鋒一轉，雖然醉後與月、影分離，但可相約在遙遠的銀河，共續無情之遊，流露李白能自我紓解、不為現實所困的高情遠致。",
      "annotation_ids": [
        "n08",
        "n09"
      ],
      "reader_annotation_ids": [
        "r7-028",
        "r7-029",
        "r7-030",
        "r7-031",
        "r7-032",
        "r7-033",
        "r7-034"
      ]
    }
  ],
  "annotations": [
    {
      "id": "n01",
      "term": "獨酌無相親",
      "explanation": "獨自飲酒而沒有可相親近的人。相親：互相親愛、親近。此處指可相親近的人。"
    },
    {
      "id": "n02",
      "term": "舉杯邀明月，對影成三人",
      "explanation": "語意出自陶潛《雜詩》：「欲言無予和，揮杯勸孤影。」三人：指李白、月和李白的影子。"
    },
    {
      "id": "n03",
      "term": "徒",
      "explanation": "徒然、空。"
    },
    {
      "id": "n04",
      "term": "將",
      "explanation": "和、共。"
    },
    {
      "id": "n05",
      "term": "及春",
      "explanation": "趁着春天。及：趁着。"
    },
    {
      "id": "n06",
      "term": "徘徊",
      "explanation": "往返迴旋、來回走動。"
    },
    {
      "id": "n07",
      "term": "醒時同交歡",
      "explanation": "清醒時與月、身影一起歡樂。交歡：一同歡樂。分散：離散、別離。"
    },
    {
      "id": "n08",
      "term": "永結無情遊",
      "explanation": "與月光和身影（本為無情之物）永遠結伴交遊。無情：即忘情，語出《莊子‧德充符》，指泯除是非得失、物我之別的境界。"
    },
    {
      "id": "n09",
      "term": "相期邈雲漢",
      "jyutping": "mok6",
      "putonghua": "mìɑo",
      "explanation": "（與月和身影）相約於遙遠的銀河之上。相期：相約。邈：遙遠。雲漢：銀漢，即銀河。"
    }
  ],
