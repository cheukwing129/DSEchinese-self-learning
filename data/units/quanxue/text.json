  "annotations": [
    {
      "id": "n01",
      "term": "君子",
      "explanation": "品格崇高的飽學之士。在篇中可理解為荀子心目中的聖哲先賢，或荀子弟子對荀子的尊稱。"
    },
    {
      "id": "n02",
      "term": "學不可以已",
      "explanation": "已：終止、放棄。"
    },
    {
      "id": "n03",
      "term": "青",
      "explanation": "靛青色顏料。藍：植物名稱，其葉可製作顏料。"
    },
    {
      "id": "n04",
      "term": "青於藍",
      "explanation": "指經提煉出的靛青色顏料，比原本藍草的青色要青得多。這個比喻包含兩方面的意思：在知識上，不斷學習可以提升我們的學養識見；在人格上，不斷學習可以提升我們的性情品位。《荀子》原文側重於後者。"
    },
    {
      "id": "n05",
      "term": "冰，水為之",
      "explanation": "冰是由水凝固而成的。"
    },
    {
      "id": "n06",
      "term": "寒於水",
      "explanation": "比水更低溫。"
    },
    {
      "id": "n07",
      "term": "木直中繩",
      "jyutping": "zung3",
      "putonghua": "zhònɡ",
      "explanation": "指樹木的枝幹本來長得筆直。中：符合、合於，動詞。繩，沾上墨的線，是古代工匠繪畫直線的工具。"
    },
    {
      "id": "n08",
      "term": "輮",
      "jyutping": "jau4",
      "putonghua": "róu",
      "explanation": "通「揉」，屈曲。一說通「煣」，指用火烘木材，使它彎曲。"
    },
    {
      "id": "n09",
      "term": "其曲中規",
      "explanation": "它的弧度合乎圓規畫出來的圖形。規：圓規。"
    },
    {
      "id": "n10",
      "term": "雖有槁暴",
      "jyutping": "buk6",
      "putonghua": "pù",
      "explanation": "有：通「又」。槁：枯乾。暴：通「曝」，曬乾。"
    },
    {
      "id": "n11",
      "term": "不復挺者",
      "explanation": "不能回復筆直的樣子。"
    },
    {
      "id": "n12",
      "term": "故木受繩則直",
      "explanation": "受繩：被工匠以墨繩校正。"
    },
    {
      "id": "n13",
      "term": "金就礪則利",
      "explanation": "金：金屬，泛指刀劍等利器。就礪：在磨刀石上磨。就：接受，動詞。礪，磨刀石。"
    },
    {
      "id": "n14",
      "term": "君子博學而日參省乎己",
      "jyutping": "caam1 / sing2",
      "putonghua": "cɑ̄n / xǐnɡ",
      "explanation": "參省：檢討反省。參：檢視、審察。省：省察、反省。另一解，「參省乎己」即《論語》曾子曰：「吾日三省吾身」之意。"
    },
    {
      "id": "n15",
      "term": "則知明",
      "explanation": "知明：心智清明。「知」：通「智」，指心思、智慧。"
    },
    {
      "id": "n16",
      "term": "而行無過矣",
      "explanation": "行：行為。"
    },
    {
      "id": "n17",
      "term": "吾嘗終日而思矣",
      "explanation": "我曾經終日思考（聖賢教化和人生禍福等道理）。"
    },
    {
      "id": "n18",
      "term": "不如須臾之所學也",
      "explanation": "須臾之所學：片刻的學習。"
    },
    {
      "id": "n19",
      "term": "吾嘗跂而望矣",
      "jyutping": "kei5",
      "putonghua": "qǐ",
      "explanation": "跂：踮起腳跟。"
    },
    {
      "id": "n20",
      "term": "聲非加疾也",
      "explanation": "聲量沒有提高。疾：猛烈，這裏指聲音宏亮。"
    },
    {
      "id": "n21",
      "term": "而聞者彰",
      "explanation": "彰：明顯、清晰。"
    },
    {
      "id": "n22",
      "term": "假輿馬者",
      "explanation": "假：假借，憑藉、利用之意。輿馬：車馬。"
    },
    {
      "id": "n23",
      "term": "非利足也",
      "explanation": "利足：跑得快。利：便利，迅疾。"
    },
    {
      "id": "n24",
      "term": "而致千里",
      "explanation": "致：達到。"
    },
    {
      "id": "n25",
      "term": "假舟楫者",
      "jyutping": "zip3",
      "putonghua": "jí",
      "explanation": "楫：船槳，這裏借代為船。"
    },
    {
      "id": "n26",
      "term": "非能水也",
      "explanation": "能水：善於游泳。水，作動詞用。"
    },
    {
      "id": "n27",
      "term": "而絕江河",
      "explanation": "絕江河：橫渡江河。絕：渡過，作動詞用。"
    },
    {
      "id": "n28",
      "term": "君子生非異也",
      "explanation": "生非異：本性與眾人沒有分別。生：通「性」，指天賦、本性。善假於物：善於借助外在的條件。物：外物，即「外在條件」。"
    },
    {
      "id": "n29",
      "term": "風雨興焉",
      "explanation": "興：興起。"
    },
    {
      "id": "n30",
      "term": "積水成淵",
      "explanation": "淵：深水之處。"
    },
    {
      "id": "n31",
      "term": "蛟龍生焉",
      "explanation": "蛟龍：蛟、龍是兩種動物，相傳蛟能引發洪水，龍可翻雲覆雨。"
    },
    {
      "id": "n32",
      "term": "而神明自得",
      "explanation": "神明自得：自然得到智慧。"
    },
    {
      "id": "n33",
      "term": "聖心備焉",
      "explanation": "聖心：聖人的精神境界。"
    },
    {
      "id": "n34",
      "term": "故不積跬步",
      "jyutping": "kwai2",
      "putonghua": "kuǐ",
      "explanation": "跬步：跬同「蹞」，半步。古人以一腳踏出為一蹞，兩腳各踏出一次為一步。"
    },
    {
      "id": "n35",
      "term": "騏驥一躍",
      "explanation": "騏驥：駿馬。"
    },
    {
      "id": "n36",
      "term": "駑馬十駕",
      "jyutping": "nou4",
      "putonghua": "nú",
      "explanation": "縱使是質素低劣的馬，憑着十日的努力，也可以完成駿馬的行程。駑馬：劣馬。十駕：十日之程。"
    },
    {
      "id": "n37",
      "term": "功在不舍",
      "explanation": "功：成效、功勞。舍：通「捨」，放棄。"
    },
    {
      "id": "n38",
      "term": "鍥而舍之",
      "jyutping": "kit3",
      "putonghua": "qiè",
      "explanation": "鍥：雕刻。"
    },
    {
      "id": "n39",
      "term": "金石可鏤",
      "jyutping": "lau6",
      "putonghua": "lòu",
      "explanation": "鏤：雕刻。"
    },
    {
      "id": "n40",
      "term": "螾無爪牙之利",
      "explanation": "螾：同「蚓」，蚯蚓。"
    },
    {
      "id": "n41",
      "term": "上食埃土",
      "explanation": "埃：細土，指土壤。"
    },
    {
      "id": "n42",
      "term": "下飲黃泉",
      "explanation": "黃泉：地底深處的水源。"
    },
    {
      "id": "n43",
      "term": "用心一也",
      "explanation": "一：專一。"
    },
    {
      "id": "n44",
      "term": "蟹六跪而二螯",
      "jyutping": "ngou4",
      "putonghua": "ɑ́o",
      "explanation": "「六跪」或作「八跪」。跪：足，名詞。螯：蟹鉗。"
    },
    {
      "id": "n45",
      "term": "非蛇蟺之穴",
      "explanation": "蟺：同「鱓」，今作「鱔」。"
    },
    {
      "id": "n46",
      "term": "無可寄託者",
      "explanation": "寄託：寄居。"
    },
    {
      "id": "n47",
      "term": "用心躁也",
      "explanation": "躁：浮躁、不專心。"
    }
  ],
