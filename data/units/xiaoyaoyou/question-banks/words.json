  "questions": [
    {
      "id": "xy-words-001",
      "unit": "xiaoyaoyou",
      "ability": "字詞",
      "knowledge_point": "虛詞辨析：而",
      "question_type": "single_choice",
      "is_cross_text": true,
      "paragraph_ref": 1,
      "difficulty": "advanced",
      "stem": "以下哪項與「吾為其無用而掊之」（《莊子．逍遙遊》（節錄））中的虛詞「而」字的詞義相同？",
      "score": 2,
      "options": [
        {
          "key": "A",
          "text": "其大本擁腫而不中繩墨。（《莊子．逍遙遊》（節錄））"
        },
        {
          "key": "B",
          "text": "今子之言，大而無用，眾所同去也。（《莊子．逍遙遊》（節錄））"
        },
        {
          "key": "C",
          "text": "醉則更相枕以卧，卧而夢，意有所極，夢亦同趣。（柳宗元《始得西山宴遊記》）"
        },
        {
          "key": "D",
          "text": "洋洋乎與造物者遊，而不知其所窮。（柳宗元《始得西山宴遊記》）"
        }
      ],
      "answer": "C",
      "explanation": "「吾為其無用而掊之」的「而」是承接連詞，解「就」，連接「無用」的原因與「掊之」的結果；C項「卧而夢」的「而」同樣是承接連詞。A、B項的「而」是轉折連詞，解「但、卻」；D項的「而」也是轉折連詞。",
      "source": "校本試題庫"
    },
    {
      "id": "xy-words-002",
      "unit": "xiaoyaoyou",
      "ability": "字詞",
      "knowledge_point": "虛詞辨析：以",
      "question_type": "single_choice",
      "is_cross_text": true,
      "paragraph_ref": 1,
      "difficulty": "advanced",
      "stem": "以下哪一句中的「以」字與「以盛水漿，其堅不能自舉也」（《逍遙遊》（節錄））中的「以」字具相同詞義？（介詞，解「用」）",
      "score": 1,
      "options": [
        {
          "key": "A",
          "text": "不宜妄自菲薄，引喻失義，以塞忠諫之路也。（《出師表》）"
        },
        {
          "key": "B",
          "text": "先帝不以臣卑鄙，猥自枉屈。（《出師表》）"
        },
        {
          "key": "C",
          "text": "願陛下託臣以討賊興復之效。（《出師表》）"
        },
        {
          "key": "D",
          "text": "秦貪，負其彊，以空言求璧。（《廉頗藺相如列傳》（節錄））"
        }
      ],
      "answer": "D",
      "explanation": "「以盛水漿」的「以」是介詞，解「用」；D項「以空言求璧」的「以」同樣解「用」。A項「以」解「以致」；B項「以」解「因為」；C項「以」解「把」。",
      "source": "校本試題庫"
    },
