      "term": "景明",
      "explanation": "陽光燦爛。景：日光。"
    },
    {
      "id": "n25",
      "term": "波瀾不驚",
      "explanation": "風平浪靜，沒有泛起半點波瀾。"
    },
    {
      "id": "n26",
      "term": "翔集",
      "explanation": "翔：飛翔。集：聚集、棲息。"
