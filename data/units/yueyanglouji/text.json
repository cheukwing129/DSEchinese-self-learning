  "annotations": [
    {
      "id": "n01",
      "term": "慶曆四年",
      "explanation": "即公元1044年。慶曆：宋仁宗年號。當時正值慶曆新政。"
    },
    {
      "id": "n02",
      "term": "滕子京",
      "explanation": "名宗諒，字子京。"
    },
    {
      "id": "n03",
      "term": "謫守",
      "explanation": "謫：貶謫、貶官。守：此處作動詞用，指擔任太守。巴陵郡：即岳州，今岳陽市。"
    },
    {
      "id": "n04",
      "term": "越明年",
      "explanation": "及至第二年。越：及至、到。"
    },
    {
      "id": "n05",
      "term": "政通人和",
      "explanation": "政事通達，人民和樂。"
    },
    {
      "id": "n06",
      "term": "具",
      "explanation": "通「俱」，全部。"
    },
    {
      "id": "n07",
      "term": "唐賢、今人",
      "explanation": "唐賢：唐代先賢如張九齡、杜甫、韓愈等。今人：當世名人如呂蒙正、夏竦等。"
    },
    {
      "id": "n08",
      "term": "屬",
      "explanation": "通「囑」，囑咐。"
    },
    {
      "id": "n09",
      "term": "勝狀",
      "explanation": "美景。勝：美。狀：狀貌、形勢。"
    },
    {
      "id": "n10",
      "term": "銜遠山",
      "explanation": "像張開口含着與岳陽樓遙遙相對的君山。銜：即「啣」。"
    },
    {
      "id": "n11",
      "term": "湯湯",
      "jyutping": "soeng1",
      "putonghua": "shɑ̄nɡ",
      "explanation": "形容水勢浩瀚。"
    },
    {
      "id": "n12",
      "term": "大觀",
      "explanation": "盛大壯觀的景象，或謂指景觀的大概情況。"
    },
    {
      "id": "n13",
      "term": "備",
      "explanation": "完備、詳盡。"
    },
    {
      "id": "n14",
      "term": "巫峽",
      "explanation": "長江三峽之一，位於四川省巫山縣。長江水經巫峽由西北方注入洞庭湖。"
    },
    {
      "id": "n15",
      "term": "瀟湘",
      "explanation": "於湖南省境內的瀟水和湘水，向北流入洞庭湖。瀟：瀟水。湘：湘水。"
    },
    {
      "id": "n16",
      "term": "遷客騷人",
      "explanation": "指貶謫流放的官吏和失意的文人雅士。遷客：被貶謫的官吏。騷人：即詩人，因屈原憂愁憂思而作《離騷》，故稱屈原或《楚辭》作者為「騷人」。"
    },
    {
      "id": "n17",
      "term": "霪雨霏霏，連月不開",
      "explanation": "霪雨：久雨。霪：通「淫」，過量。霏霏：形容雨絲細密。開：放晴，天色開朗。"
    },
    {
      "id": "n18",
      "term": "陰風怒號",
      "jyutping": "hou4",
      "putonghua": "hɑ́o",
      "explanation": "陰：陰冷。怒號：形容風聲激越。號：呼嘯。"
    },
    {
      "id": "n19",
      "term": "排空",
      "explanation": "指浪濤洶湧，直上雲霄。"
    },
    {
      "id": "n20",
      "term": "檣傾楫摧",
      "jyutping": "coeng4 / zip3",
      "putonghua": "qiɑ́nɡ / jí",
      "explanation": "船隻翻覆沉沒。檣：船的桅杆。傾：倒下。楫：船槳。摧：摧毀。"
    },
    {
      "id": "n21",
      "term": "薄暮冥冥",
      "jyutping": "ming4",
      "putonghua": "mínɡ",
      "explanation": "薄：通「迫」，迫近。冥：昏暗、陰沉。"
    },
