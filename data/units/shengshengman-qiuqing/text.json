{
  "unit_id": "shengshengman-qiuqing",
  "paragraphs": [
    {
      "id": 1,
      "label": "上片‧疊字起興",
      "text": "尋尋覓覓，冷冷清清，悽悽慘慘戚戚。",
      "summary": "連用七組疊字，由外而內、由弱到強地傳達情感從失落、清冷轉為悽戚悲痛的過程，是歷來備受激賞的名句。",
      "annotation_ids": [],
      "reader_annotation_ids": [
        "r1-001",
        "r1-002",
        "r1-003"
      ]
    },
    {
      "id": 2,
      "label": "上片‧風寒難禦",
      "text": "乍煖還寒時候，最難將息。三杯兩盞淡酒，怎敵他，晚來風急！",
      "summary": "深秋天氣變化無常，難以調養休息；淡酒難敵晚來寒風，實則難敵的是內心的悽寒，含蓄地表達內心愁苦。",
      "annotation_ids": [
        "n01",
        "n02",
        "n03"
      ],
      "reader_annotation_ids": [
        "r2-004",
        "r2-005",
        "r2-006",
        "r2-007",
        "r2-008",
        "r2-009",
        "r2-010",
        "r2-011",
        "r2-012"
      ]
    },
    {
      "id": 3,
      "label": "上片‧雁過傷心",
      "text": "雁過也，正傷心，卻是舊時相識。",
      "summary": "正傷心之際見征雁飛過，雁曾是傳信的舊識，如今丈夫已逝、故土難返，雁的無知無識反而更添傷心惆悵。",
      "annotation_ids": [],
      "reader_annotation_ids": [
        "r3-013",
        "r3-014",
        "r3-015",
        "r3-016"
      ]
    },
    {
      "id": 4,
      "label": "下片‧黃花憔悴",
      "text": "滿地黃花堆積，憔悴損，如今有誰堪摘？",
      "summary": "遍地黃花凋謝或盛放堆積，「憔悴損」既可指花亦可指人，詞人歷經離亂、身心疲憊，正如那憔悴的黃花，也再無人可以相贈。",
      "annotation_ids": [
        "n04"
      ],
      "reader_annotation_ids": [
        "r4-017",
        "r4-018",
        "r4-019",
        "r4-020",
        "r4-021",
        "shengshengman-qiuqing-teacher-4-1"
      ]
    },
    {
      "id": 5,
      "label": "下片‧獨守寒窗",
      "text": "守着窗兒，獨自怎生得黑！梧桐更兼細雨，到黃昏、點點滴滴。",
      "summary": "獨自守着寒窗，盼望黑夜早來卻時間難熬；梧桐細雨在黃昏時分點點滴滴，聲聲入耳，更添惆悵愁思。",
      "annotation_ids": [],
      "reader_annotation_ids": [
        "r5-022",
        "r5-023",
        "r5-024",
        "r5-025",
        "r5-026",
        "shengshengman-qiuqing-teacher-5-2",
        "shengshengman-qiuqing-teacher-5-3"
      ]
    },
    {
      "id": 6,
      "label": "下片‧愁情難盡",
      "text": "這次第，怎一箇愁字了得！",
      "summary": "以反問總結全詞，種種景象所帶來的愁緒，又怎是一個「愁」字可以概括得了，是全詞情感的最高潮與總收結。",
      "annotation_ids": [
        "n05",
        "n06"
      ],
      "reader_annotation_ids": [
        "r6-027",
        "r6-028",
        "r6-029",
        "r6-030"
      ]
    }
  ],
